#!/usr/bin/env python3
import sys
import os
import re
import glob
import socket
import subprocess
from datetime import datetime
from collections import Counter, defaultdict

# ANSI Color formatting for quick visual triage
COLOR_RESET = "\033[0m"
COLOR_RED   = "\033[1;31m"
COLOR_YELLOW= "\033[1;33m"
COLOR_GREEN = "\033[1;32m"
COLOR_CYAN  = "\033[1;36m"
COLOR_BOLD  = "\033[1m"

def colorize(text, level="INFO"):
    if not sys.stdout.isatty():
        return text
    if level == "CRIT":
        return f"{COLOR_RED}{text}{COLOR_RESET}"
    elif level == "WARN":
        return f"{COLOR_YELLOW}{text}{COLOR_RESET}"
    elif level == "OK":
        return f"{COLOR_GREEN}{text}{COLOR_RESET}"
    elif level == "HEADER":
        return f"{COLOR_CYAN}{COLOR_BOLD}{text}{COLOR_RESET}"
    return text

def run_cmd(cmd, timeout=5):
    """Executes shell commands safely with a timeout to prevent hanging."""
    try:
        res = subprocess.run(
            cmd,
            shell=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=timeout,
            text=True,
            errors="ignore"
        )
        return res.stdout.strip()
    except subprocess.TimeoutExpired:
        return f"[TIMEOUT] Command '{cmd}' timed out after {timeout}s"
    except Exception as e:
        return f"[ERROR] {e}"

def print_header(title):
    print(colorize(f"\n=== {title} ===", "HEADER"))

def get_proc_mem():
    """Reads /proc/meminfo directly for fast execution without spawning subprocesses."""
    mem_info = {}
    try:
        with open("/proc/meminfo", "r") as f:
            for line in f:
                parts = line.split(":")
                if len(parts) == 2:
                    key = parts[0].strip()
                    val = parts[1].strip().split()[0]
                    mem_info[key] = int(val)
        total = mem_info.get("MemTotal", 0) / 1024  # MB
        avail = mem_info.get("MemAvailable", 0) / 1024  # MB
        used = total - avail
        percent = (used / total * 100) if total > 0 else 0
        return total, used, avail, percent
    except Exception:
        return 0, 0, 0, 0

def check_disk_usage():
    """Checks disk space usage for root and common web paths."""
    print_header("DISK SPACE & INODE STATUS")
    df_output = run_cmd("df -h -x devtmpfs -x tmpfs")
    print(df_output)

    for line in df_output.splitlines()[1:]:
        parts = line.split()
        if len(parts) >= 5:
            use_pct_str = parts[-2].replace("%", "")
            mount_pt = parts[-1]
            if use_pct_str.isdigit():
                use_pct = int(use_pct_str)
                if use_pct >= 90:
                    print(colorize(f"[CRITICAL] Mount '{mount_pt}' is at {use_pct}% capacity!", "CRIT"))
                elif use_pct >= 80:
                    print(colorize(f"[WARNING] Mount '{mount_pt}' is at {use_pct}% capacity.", "WARN"))

def check_top_processes():
    """Identifies high CPU and high RAM processes."""
    print_header("TOP RESOURCE-CONSUMING PROCESSES")
    print(colorize("--- Top 5 CPU Consumers ---", "WARN"))
    print(run_cmd("ps aux --sort=-%cpu | head -n 6"))
    
    print(colorize("\n--- Top 5 Memory Consumers ---", "WARN"))
    print(run_cmd("ps aux --sort=-%mem | head -n 6"))

def check_mysql():
    """Performs a quick process check for MariaDB/MySQL."""
    print_header("DATABASE STATUS & PROCESSLIST")
    mysql_proc = run_cmd("pgrep -x mysqld || pgrep -x mariadbd")
    if not mysql_proc:
        print(colorize("[CRITICAL] MySQL/MariaDB daemon is NOT running!", "CRIT"))
    else:
        print(colorize("[OK] MySQL/MariaDB service is running.", "OK"))
        print("\nActive Queries / Connections (Top 10):")
        processlist = run_cmd("mysqladmin procstat 2>/dev/null || mysql -e 'SHOW FULL PROCESSLIST;' 2>/dev/null | head -n 12")
        if processlist:
            print(processlist)
        else:
            print("Unable to fetch processlist via local socket (Auth required or socket unavailable).")

def main():
    today_str = datetime.now().strftime("%d/%b/%Y")

    print("========================================================")
    print("      OCC EMERGENCY DIAGNOSTICS ENGINE (v4.1)")
    print(f"      Server Date: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')} | Log Date: {today_str}")
    print("========================================================")

    # 1. SERVER IDENTITY & SYSTEM METRICS
    print_header("SERVER IDENTITY & SYSTEM METRICS")
    hostname = run_cmd("hostname")
    try:
        host_ip = socket.gethostbyname(hostname)
    except Exception:
        host_ip = "N/A"
    
    print(f"Hostname    : {hostname}")
    print(f"Server IP   : {host_ip}")

    # Load Average
    load = os.getloadavg() if hasattr(os, "getloadavg") else (0, 0, 0)
    cpu_count = os.cpu_count() or 1
    load_status = "OK"
    if load[0] > cpu_count * 2:
        load_status = "CRIT"
    elif load[0] > cpu_count:
        load_status = "WARN"

    load_fmt = f"{load[0]:.2f} / {load[1]:.2f} / {load[2]:.2f} (Cores: {cpu_count})"
    print(f"Load Avg    : {colorize(load_fmt, load_status)}")

    # Memory Usage via /proc/meminfo
    total_mem, used_mem, avail_mem, mem_pct = get_proc_mem()
    mem_status = "CRIT" if mem_pct > 90 else ("WARN" if mem_pct > 80 else "OK")
    mem_fmt = f"{used_mem:.0f}MB / {total_mem:.0f}MB ({mem_pct:.1f}% used | Free/Avail: {avail_mem:.0f}MB)"
    print(f"Memory      : {colorize(mem_fmt, mem_status)}")

    # 2. RUN SUB-CHECKS
    check_disk_usage()
    check_top_processes()
    check_mysql()

    print("\n========================================================")
    print(colorize("Diagnostics Check Complete.", "OK"))
    print("========================================================\n")

if __name__ == "__main__":
    main()
