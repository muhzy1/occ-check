#!/usr/bin/env python3
import sys
import os
import re
import glob
import time
import argparse
import subprocess
from datetime import datetime, timedelta
from collections import Counter, defaultdict

def parse_time_delta(time_str):
    unit = time_str[-1].lower()
    try:
        val = int(time_str[:-1])
    except ValueError:
        val = 1
        unit = 'h'
    if unit == 's': return timedelta(seconds=val)
    if unit == 'm': return timedelta(minutes=val)
    if unit == 'h': return timedelta(hours=val)
    if unit == 'd': return timedelta(days=val)
    return timedelta(hours=1)

class SystemAudit:
    @staticmethod
    def run_all():
        load = os.getloadavg() if hasattr(os, 'getloadavg') else (0, 0, 0)
        print(f"[+] System Load Average : {load[0]:.2f} / {load[1]:.2f} / {load[2]:.2f}")
        try:
            with open('/proc/meminfo', 'r') as f:
                mem = {line.split(':')[0].strip(): int(line.split(':')[1].split()[0]) for line in f if ':' in line}
            total_mb = mem.get('MemTotal', 0) / 1024
            free_mb = mem.get('MemAvailable', mem.get('MemFree', 0)) / 1024
            used_mb = total_mb - free_mb
            pct = (used_mb / total_mb * 100) if total_mb else 0
            print(f"[+] RAM Usage            : {used_mb:.1f}MB / {total_mb:.1f}MB ({pct:.1f}% used)")
        except Exception:
            pass

class ApacheAudit:
    @staticmethod
    def check_scoreboard_and_errors():
        print("\n--- Apache Configuration & Error Audit ---")
        err_log = '/usr/local/apache/logs/error_log'
        if os.path.exists(err_log):
            try:
                out = subprocess.check_output(['tail', '-n', '500', err_log], stderr=subprocess.DEVNULL).decode('utf-8', errors='ignore')
                sb_errors = [l for l in out.splitlines() if 'AH03490' in l or 'scoreboard is full' in l]
                if sb_errors:
                    print(f"  [!] CRITICAL: Scoreboard full errors detected in Apache error log ({len(sb_errors)} recent hits)!")
                    print("      -> Action Required: Increase ServerLimit in /etc/apache2/conf.d/includes/pre_virtualhost_global.conf")
                else:
                    print("  [+] Clean: No recent scoreboard full errors in Apache logs.")
            except Exception:
                pass

class DiskAudit:
    @staticmethod
    def check_disks():
        print("\n--- Storage & Partition Health ---")
        try:
            df_out = subprocess.check_output(['df', '-hP'], stderr=subprocess.DEVNULL).decode('utf-8', errors='ignore')
            for line in df_out.splitlines()[1:]:
                parts = line.split()
                if len(parts) >= 6:
                    mount, pct_str = parts[5], parts[4].replace('%', '')
                    if pct_str.isdigit():
                        pct = int(pct_str)
                        flag = " [CRITICAL]" if pct >= 90 else (" [WARNING]" if pct >= 80 else "")
                        print(f"  * {mount:<15} : {parts[2]} used / {parts[1]} total ({parts[4]} used){flag}")
        except Exception:
            pass

class FileAudit:
    @staticmethod
    def check_malware():
        print("\n--- Web Shell & Malware Audit ---")
        known_shells = ['wso.php', 'alfa.php', 'c99.php', 'r57.php', 'shell.php', 'x.php', '.index.php']
        found_shells = []
        
        home_dirs = glob.glob('/home/*/public_html')
        for hdir in home_dirs:
            try:
                for root, _, files in os.walk(hdir):
                    for f in files:
                        if f.lower() in known_shells or (f.startswith('.') and f.endswith('.php')):
                            found_shells.append(os.path.join(root, f))
            except Exception:
                pass

        if found_shells:
            print(f"  [!] CRITICAL: {len(found_shells)} Web Shell(s) or Hidden PHP Script(s) Identified:")
            for sh in found_shells[:15]:
                print(f"      * {sh}")
        else:
            print("  [+] Clean: No standard webshell filenames detected in /home/*/public_html.")

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--last', type=str, default="1h")
    args = parser.parse_args()

    print("========================================================")
    print("OCC EMERGENCY DIAGNOSTICS ENGINE (v2.2)")
    print("========================================================")
    SystemAudit.run_all()
    DiskAudit.check_disks()
    ApacheAudit.check_scoreboard_and_errors()
    FileAudit.check_malware()
    print("========================================================")

if __name__ == '__main__':
    main()
