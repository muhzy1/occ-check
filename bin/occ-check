#!/usr/bin/env bash
set -euo pipefail

python3 - "$@" << 'PYTHON_ENGINE'
import os
import re
import sys
import glob
import urllib.request
import subprocess
from datetime import datetime, timedelta
from collections import Counter

class OOMCollector:
    OOM_PATTERN = re.compile(
        r'\[(?P<timestamp>[^\]]+)\]\s+Out of memory:\s+Killed process\s+(?P<pid>\d+)\s+\((?P<process>[^\)]+)\)\s+total-vm:(?P<vm>\d+)kB,\s+anon-rss:(?P<rss>\d+)kB'
    )

    def collect(self) -> dict:
        findings = []
        try:
            raw_output = subprocess.check_output(
                ["dmesg", "-T"], stderr=subprocess.DEVNULL, text=True
            )
        except Exception:
            return {"oom_events": [], "count": 0}

        for line in raw_output.splitlines():
            if "Out of memory" in line or "killed process" in line.lower():
                match = self.OOM_PATTERN.search(line)
                if match:
                    data = match.groupdict()
                    findings.append({
                        "process": data["process"],
                        "pid": data["pid"],
                        "rss_mb": round(int(data["rss"]) / 1024, 2),
                        "total_vm_mb": round(int(data["vm"]) / 1024, 2),
                    })

        return {"oom_events": findings, "count": len(findings)}

class ApacheStatusCollector:
    def collect(self, status_url: str = "http://127.0.0.1/server-status?auto") -> dict:
        try:
            req = urllib.request.Request(status_url, headers={"User-Agent": "occ-check/1.0"})
            with urllib.request.urlopen(req, timeout=3) as resp:
                content = resp.read().decode('utf-8')
        except Exception as e:
            return {"available": False, "error": str(e)}

        stats = {}
        for line in content.splitlines():
            if ":" in line:
                key, val = line.split(":", 1)
                stats[key.strip()] = val.strip()

        scoreboard = stats.get("Scoreboard", "")
        busy_workers = int(stats.get("BusyWorkers", 0))
        idle_workers = int(stats.get("IdleWorkers", 0))
        total_workers = busy_workers + idle_workers
        open_slots = scoreboard.count(".")

        return {
            "available": True,
            "busy_workers": busy_workers,
            "idle_workers": idle_workers,
            "is_exhausted": (open_slots == 0 and total_workers > 0)
        }

class AccessLogCollector:
    LOG_PATHS = [
        "/var/log/httpd/access_log",
        "/var/log/apache2/access.log",
        "/var/log/nginx/access.log",
        "/var/log/apache2/other_vhosts_access.log",
        "/etc/httpd/logs/access_log",
        "/usr/local/apache/logs/access_log",
    ]
    LOG_PATTERN = re.compile(r'^(\S+)\s+.*?\[(\d{2}\/[A-Za-z]{3}\/\d{4}:\d{2}:\d{2}:\d{2})')

    def parse_window(self, window_str: str) -> timedelta:
        unit = window_str[-1].lower() if window_str else 'm'
        try:
            num = int(window_str[:-1])
        except ValueError:
            return timedelta(minutes=15)

        if unit == 's':
            return timedelta(seconds=num)
        elif unit == 'm':
            return timedelta(minutes=num)
        elif unit == 'h':
            return timedelta(hours=num)
        elif unit == 'd':
            return timedelta(days=num)
        return timedelta(minutes=15)

    def find_log_files(self) -> list:
        found = [path for path in self.LOG_PATHS if os.path.exists(path)]
        cpanel_domlogs = glob.glob("/usr/local/apache/domlogs/*")
        for log in cpanel_domlogs:
            if os.path.isfile(log) and not log.endswith(('-bytes', '-ssl_log')):
                found.append(log)
        return found

    def collect(self, window_str: str = "15m", top_n: int = 10) -> dict:
        log_files = self.find_log_files()
        if not log_files:
            return {"available": False, "error": "No accessible access logs found in standard paths"}

        delta = self.parse_window(window_str)
        ip_counts = Counter()
        total_requests = 0
        latest_dt = None

        for filepath in log_files:
            try:
                with open(filepath, 'r', encoding='utf-8', errors='ignore') as f:
                    f.seek(0, os.SEEK_END)
                    size = f.tell()
                    f.seek(max(0, size - 200000))
                    for line in f:
                        match = self.LOG_PATTERN.match(line)
                        if match:
                            try:
                                dt = datetime.strptime(match.group(2), "%d/%b/%Y:%H:%M:%S")
                                if latest_dt is None or dt > latest_dt:
                                    latest_dt = dt
                            except ValueError:
                                pass
            except Exception:
                continue

        if not latest_dt:
            latest_dt = datetime.now()

        cutoff_dt = latest_dt - delta

        for filepath in log_files:
            try:
                with open(filepath, 'r', encoding='utf-8', errors='ignore') as f:
                    f.seek(0, os.SEEK_END)
                    size = f.tell()
                    f.seek(max(0, size - 3000000))
                    for line in f:
                        match = self.LOG_PATTERN.match(line)
                        if match:
                            ip, ts_str = match.groups()
                            try:
                                dt = datetime.strptime(ts_str, "%d/%b/%Y:%H:%M:%S")
                                if dt >= cutoff_dt:
                                    ip_counts[ip] += 1
                                    total_requests += 1
                            except ValueError:
                                pass
            except Exception:
                continue

        return {
            "available": True,
            "logs_scanned": len(log_files),
            "total_requests": total_requests,
            "top_ips": ip_counts.most_common(top_n)
        }

def main():
    parser = argparse.ArgumentParser(prog="occ-check", description="Server Emergency Diagnostics Tool")
    parser.add_argument("--traffic", action="store_true", help="Run traffic analysis")
    parser.add_argument("--last", type=str, default="15m", help="Time window (e.g. 15m, 1h)")
    args, unknown = parser.parse_known_args()

    oom = OOMCollector().collect()
    apache = ApacheStatusCollector().collect()
    traffic = AccessLogCollector().collect(window_str=args.last)

    print("========================================================")
    print("OCC EMERGENCY DIAGNOSTICS ENGINE")
    print("========================================================")
    print(f"[+] Kernel OOM Events Detected: {oom['count']}")
    for event in oom['oom_events']:
        print(f"    - Killed PID {event['pid']} ({event['process']}) - Freed {event['rss_mb']} MB")
        
    print(f"[+] Apache Scoreboard Available: {apache['available']}")
    if apache['available']:
        print(f"    - Busy Workers: {apache['busy_workers']}")
        print(f"    - Exhausted: {apache['is_exhausted']}")
    else:
        print(f"    - Error: {apache.get('error')}")

    print(f"[+] Traffic Analysis (Last {args.last}):")
    if traffic['available']:
        print(f"    - Logs Scanned: {traffic['logs_scanned']}")
        print(f"    - Total Requests in Window: {traffic['total_requests']}")
        print(f"    - Top IP Addresses:")
        for ip, count in traffic['top_ips']:
            print(f"      * {ip:<15} - {count} requests")
    else:
        print(f"    - Notice: {traffic.get('error')}")

    print("========================================================")

if __name__ == "__main__":
    main()
PYTHON_ENGINE
